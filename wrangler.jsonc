{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentread",
  "main": "src/index.ts",
  // Must not be newer than the workerd bundled with wrangler / @cloudflare/vitest-plugin.
  "compatibility_date": "2026-08-01",
  // @x402/hono and @x402/core use Buffer; nodejs_compat provides it.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "upload_source_maps": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Workers AI binding: used only for its free HTML→Markdown conversion (EXTRACTION_ENGINE=lite).
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "FREE_QUOTA", "class_name": "FreeQuota" }] },
  // FreeQuota (free daily allowance counters). SQLite-backed, which the Workers Free plan supports.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FreeQuota"] }],

  // Top-level config = local development (`wrangler dev`). Always testnet.
  // X402_PAY_TO for local dev goes in .dev.vars (see .dev.vars.example).
  "vars": {
    "ENVIRONMENT": "development",
    "X402_NETWORK": "eip155:84532",
    "X402_FACILITATOR_URL": "https://x402.org/facilitator",
    "PRICE_EXTRACT_USD": "0.003",
    "PRICE_EXTRACT_STRUCTURED_USD": "0.005",
    "DNS_CHECK": "doh",
    // "lite" fits the Workers Free plan (measured); switch to "readability" on Workers Paid.
    "EXTRACTION_ENGINE": "lite"
  },
  "ratelimits": [
    { "name": "INSPECT_RATE_LIMITER", "namespace_id": "41001", "simple": { "limit": 30, "period": 60 } },
    { "name": "PAID_RATE_LIMITER", "namespace_id": "41002", "simple": { "limit": 120, "period": 60 } }
  ],

  "env": {
    "production": {
      "name": "agentread",
      // Bindings are not inherited by environments; declare the AI binding per env.
      "ai": { "binding": "AI" },
      "durable_objects": { "bindings": [{ "name": "FREE_QUOTA", "class_name": "FreeQuota" }] },
      "vars": {
        "ENVIRONMENT": "production",
        "X402_NETWORK": "eip155:8453",
        "X402_FACILITATOR_URL": "https://api.cdp.coinbase.com/platform/v2/x402",
        // Public mainnet receiving address (owner's Trust Wallet, USDC on Base). Not a secret.
        "X402_PAY_TO": "0xb866dD8C8401438Efb29b538ec4df11b6b407Ce6",
        "PRICE_EXTRACT_USD": "0.003",
        "PRICE_EXTRACT_STRUCTURED_USD": "0.005",
        "DNS_CHECK": "doh",
        "EXTRACTION_ENGINE": "lite"
      },
      // Secrets (set with `wrangler secret put --env production`):
      //   CDP_API_KEY_ID, CDP_API_KEY_SECRET
      "ratelimits": [
        { "name": "INSPECT_RATE_LIMITER", "namespace_id": "41021", "simple": { "limit": 30, "period": 60 } },
        { "name": "PAID_RATE_LIMITER", "namespace_id": "41022", "simple": { "limit": 120, "period": 60 } }
      ]
    }
  }
}
