# Configuration for the CLIENT-SIDE scripts in scripts/ (Node.js), not the Worker.
# Worker config lives in wrangler.jsonc (vars) + .dev.vars / `wrangler secret put` (secrets).
# Placeholders only. Never commit real keys.

# Base URL of the AgentRead deployment to test against.
AGENTREAD_URL=http://localhost:8787

# Private key of a TESTNET-ONLY wallet funded with Base Sepolia USDC
# (https://faucet.circle.com). Used to sign x402 payments in the smoke scripts.
EVM_PRIVATE_KEY=0xyour_testnet_only_private_key

# URL the smoke tests extract.
SMOKE_TARGET_URL=https://example.com/
