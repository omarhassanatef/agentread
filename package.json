{
  "name": "agentread",
  "version": "0.2.0",
  "private": true,
  "description": "Clean web content for AI agents, paid per request via x402.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev --remote",
    "build": "wrangler deploy --dry-run --outdir dist --env=\"\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "cf-typegen": "wrangler types",
    "deploy:production": "wrangler deploy --env production",
    "smoke:local": "node scripts/smoke-local.mjs",
    "smoke:testnet": "node scripts/testnet-smoke.mjs",
    "smoke:mcp": "node scripts/mcp-client-example.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@coinbase/x402": "2.1.0",
    "@joplin/turndown-plugin-gfm": "1.0.68",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mozilla/readability": "0.6.0",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/extensions": "2.28.0",
    "@x402/hono": "2.28.0",
    "@x402/mcp": "2.28.0",
    "hono": "4.13.13",
    "linkedom": "0.18.14",
    "turndown": "7.2.4",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@types/turndown": "5.0.6",
    "@x402/fetch": "2.28.0",
    "typescript": "5.9.3",
    "viem": "2.57.10",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  },
  "license": "MIT"
}
